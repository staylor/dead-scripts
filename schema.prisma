datasource db {
  provider = "sqlite"
  url      = "file:dev.db"
}

generator client {
  provider = "prisma-client"
  output   = "src/prisma/client"
}

model Song {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  lyrics       String?
  fileName     String?
  trackNumber  Int?
  discNumber   Int?
  songType     String? // e.g. "cover"
  album        Album?   @relation(fields: [albumId], references: [id])
  albumId      Int?
  singer       Singer?  @relation(fields: [singerId], references: [id])
  singerId     Int?
  writers      Writer[]
  appleMusicId String?

  @@index([name])
}

model Album {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  releaseYear  Int?
  appleMusicId String?
  artist       Artist? @relation(fields: [artistId], references: [id])
  artistId     Int?
  songs        Song[]

  @@index([name])
}

model Artist {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  appleMusicId String?
  albums       Album[]

  @@index([name])
}

model Singer {
  id           Int     @id @default(autoincrement())
  name         String
  slug         String  @unique
  appleMusicId String?
  songs        Song[]

  @@index([name])
}

model Writer {
  id           Int    @id @default(autoincrement())
  name         String
  slug         String
  contribution String
  songs        Song[]

  @@unique([slug, contribution])
}
